# Server port
PORT=3001

# Production secret: REQUIRED in production (must not use default)
JWT_SECRET=change-me-in-production

# Allowed CORS origins for API requests (comma-separated if multiple)
CLIENT_ORIGIN=http://localhost:5173

# Node environment: 'development' or 'production'
NODE_ENV=development

# Storage paths (Optional: defaults to server/data and server/uploads. Useful for persistent volume mounts e.g. on Railway)
# DATA_DIR=/app/storage/data
# UPLOADS_DIR=/app/storage/uploads
